# Variables de entorno para Biohub Venture Web
# ─────────────────────────────────────────────
# IMPORTANTE: Este archivo es solo una plantilla.
# Copia este archivo como ".env.local" y rellena los valores reales.
# .env.local está en .gitignore y NUNCA debe subirse a GitHub.

# ── Supabase ──────────────────────────────────
# Obtén estos valores en: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...TU_ANON_PUBLIC_KEY...

# ── Webhook opcional (Zapier / Make) ──────────
# Si se configura, los formularios también envían los datos al webhook.
# VITE_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXX/YYYY/
